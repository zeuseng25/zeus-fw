<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zeus</groupId>
        <artifactId>zeus-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../zeus-parent/pom.xml</relativePath>
    </parent>

    <artifactId>zeus-base</artifactId>
    <packaging>jar</packaging>

    <name>Zeus Base</name>
    <description>Temel modül: ortak exception/ProblemDetail altyapısı, çekirdek tipler.
        Diğer tüm zeus modülleri bunu kullanır.</description>

    <dependencies>
        <!-- Auto-configuration kancası için. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- SLF4J API: loglama cephesi. Diğer zeus modülleri bunu zeus-base üzerinden alır. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- Hedeflenen içerik: @RestControllerAdvice + ProblemDetail (RFC 7807). -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- ZeusServletInitializer (WAR başlatıcısı) için. provided: servlet API'sini runtime'da
             kapsayıcı (WildFly/Undertow ya da embedded Tomcat) sağlar; WAR'a ve com.zeus
             module'üne girmez (script jakarta.*-api'leri zaten dışlar). -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- RestClient/RestTemplate customizer'ları (correlation ID'yi giden çağrılara ekler).
             optional: zeus-base'i kullanan her uygulama HTTP istemcisi kullanmak zorunda değil;
             classpath'te yoksa ZeusCorrelationAutoConfiguration'ın ilgili iç sınıfı
             @ConditionalOnClass ile devre dışı kalır. Paylaşımlı com.zeus module'ünde jar
             zaten mevcuttur (starter-restclient). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>
