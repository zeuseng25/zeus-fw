<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zeus</groupId>
        <artifactId>zeus-fw</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>zeus-parent</artifactId>
    <packaging>pom</packaging>

    <name>Zeus Framework Parent</name>
    <description>Uygulamaların ve zeus modüllerinin parent'ı (spring-boot-starter-parent benzeri):
        zeus-dependencies BOM import'u + ortak plugin yönetimi.</description>

    <properties>
        <!-- App-specific WAR-bundle opt-in'i (ince WAR istisnası).
             Varsayılan BOŞ → yalnız zeus-* jar'ları WAR'da kalır (3. parti hep module'den).
             Bir uygulamanın YALNIZCA kendi kullandığı, framework'te/paylaşımlı module'de OLMAYAN
             bir kütüphaneyi kendi WAR'ında taşıması gerekiyorsa, app pom'unda bu property'yi
             '|<artifactId-öneki>-' biçiminde set eder (war-plugin config'ini override ETMEDEN).
             Örn: <zeus.war.keep>|foo-|bar-</zeus.war.keep>
             Detay: zeus-fw/gelistirmeler/08-wildfly-module-dagitim.md (App-specific dependency). -->
        <zeus.war.keep/>

        <!-- Uygulamanın bağlanacağı paylaşımlı WildFly module SLOT'u (com.zeus:<slot>).
             Üretilen jboss-deployment-structure.xml'e filtering ile yazılır (zeus-war-defaults
             şablonu + aşağıdaki zeus-generated-descriptor profili).

             Değeri PLATFORM release başına sabitler (uygulama pom'unda OVERRIDE EDİLMEZ):
             - Module içeriği (3. parti sürümler) değişen release'de → yeni versiyonlu slot
               (örn. 1.1.0). install-zeus-module.sh - -slot 1.1.0 ile sunucuya kurulur; app'ler
               parent sürümünü yükseltince otomatik yeni slot'a bağlanır (restart'sız geçiş).
             - Module içeriği değişmeyen release'de → önceki slot değeri korunur
               (gereksiz slot kopyası oluşmaz).
             Detay: gelistirmeler/10-versiyonlu-slot-uretilen-descriptor.md -->
        <zeus.module.slot>main</zeus.module.slot>

        <!-- Uygulama TİPİNİN descriptor şablon dizini (zeus-war-defaults içindeki dizin adı).
             Tip parent'ları override eder: descriptor-soap (zeus-soap-parent),
             descriptor-bff (zeus-bff-parent). Varsayılan: standart ince-WAR REST tipi. -->
        <zeus.descriptor.dir>descriptor-standard</zeus.descriptor.dir>

        <!-- Uygulamaya özel EK deployment module bağımlılıkları (varsayılan: BOŞ — bu property
             eklenmekle hiçbir mevcut uygulamanın davranışı değişmez). Değeri, ince WAR
             (standard/soap) şablonlarındaki <dependencies> bloğuna OLDUĞU GİBİ yazılır; XML
             parçası olduğu için uygulama pom'unda entity ile kaçırılır:

               <zeus.descriptor.extra.modules>&amp;lt;module name="com.oracle.ojdbc"/&amp;gt;</zeus.descriptor.extra.modules>

             NE ZAMAN GEREKİR: uygulama (tipik olarak devralınan bir util katmanı) sürücü ya da
             3. parti sınıflara KOD olarak bağlıysa — Class.forName("oracle.jdbc.OracleDriver"),
             Connection'ı OracleConnection'a unwrap, OracleTypes.CURSOR gibi. İnce WAR'da o
             sınıflar KASTEN yoktur (WEB-INF/lib'de yok, com.zeus module'ünde yok) → deploy
             "could not load JDBC driver class" ile düşer. Datasource'un jboss-cli testi bu
             durumda YEŞİLDİR: sunucu sürücüyü yükleyebiliyordur, yükleyemeyen deployment'tır.

             NEDEN JAR KOPYASI DEĞİL DE MODULE IMPORT: sunucunun com.oracle.ojdbc module'ü,
             JCA katmanının datasource için kullandığı module'ün TA KENDİSİDİR; import edilince
             sınıf kimliği tek kalır. Jar'ı WAR'a veya com.zeus'a kopyalamak ise İKİNCİ bir
             kopya yaratır → JNDI'dan gelen Connection ile uygulamanın gördüğü tip ayrışır →
             ClassCastException/LinkageError (gelistirmeler/08-wildfly-module-dagitim.md).

             FAT WAR TİPLERİNDE ETKİSİZDİR (bilinçli): zeus-bff-parent / zeus-standalone-parent
             şablonlarında <dependencies> bloğu yoktur ve sürücü zaten WAR'ın içindedir; orada
             module import etmek tam da kaçınılan çift kopyayı yaratırdı. O tiplerin çözümü
             sürücüyü 'provided' bildirmektir (gelistirmeler/14-uygulama-tipi-parentlar.md).

             Bu bir GEÇİŞ mekanizmasıdır, kalıcı hedef değil: doğru çözüm util'in sürücü
             sınıflarına olan bağımlılığını kaldırmaktır (JNDI DataSource + java.sql.Types
             .REF_CURSOR). Property'yi kullanan uygulama bunu teknik borç olarak izler. -->
        <zeus.descriptor.extra.modules/>

        <!-- İnce WAR politikası (property üzerinden — TİP kararıdır, uygulama kararı değil):
             standart/soap tiplerinde yalnız zeus-* jar'ları WAR'da kalır; zeus-bff-parent bu
             property'yi BOŞALTIR (fat WAR: BFF izoledir, com.zeus module kullanmaz). -->
        <zeus.war.packaging-excludes>%regex[WEB-INF/lib/(?!(zeus-${zeus.war.keep})).*\.jar]</zeus.war.packaging-excludes>
        <!-- surefire argLine'ının GEÇ BAĞLAMA (@{argLine}) tabanı.
             Boş tanımlı olması şart: aşağıdaki surefire yapılandırması @{argLine} ile başlar;
             property hiç tanımlı olmazsa surefire ifadeyi literal bırakır ve JVM açılmaz.
             Bir uygulama JaCoCo eklerse prepare-agent bu property'yi doldurur, Mockito
             javaagent'ı onun ÜSTÜNE eklenir — iki agent birbirini ezmez. -->
        <argLine></argLine>
    </properties>

    <!-- ═══════════ Tüm zeus modüllerine ve tüketen uygulamalara ORTAK bağımlılıklar ═══════════ -->
    <dependencies>
        <!-- TEST ALTYAPISI — FRAMEWORK KARARI, uygulama yazmaz.
             Neden burada: surefire provider'ını test classpath'ini tarayarak seçer. JUnit
             Platform motoru (junit-jupiter-engine) yoksa son çare olarak JUnit3Provider'a
             düşer — ve build KIRILMAZ: JUnit 5 anotasyonlarını tanımadığı için "Tests run: 0"
             yazıp yeşil geçer. Hiç test çalıştırmayan yeşil build, kırmızıdan çok daha
             tehlikelidir. Bu bağımlılık motoru garanti eder, provider bir daha junit3'e düşemez.

             İnce WAR'a etkisi YOK: test scope ne WAR'a girer ne com.zeus module'üne
             (install-zeus-module.sh -DincludeScope=runtime kullanır, test scope dışarıdadır). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <!-- Zeus BOM: zeus-parent'ı parent alan her proje sürüm yazmadan
                 zeus-* modüllerini ve yönetilen 3. parti kütüphaneleri kullanabilir. -->
            <dependency>
                <groupId>com.zeus</groupId>
                <artifactId>zeus-dependencies</artifactId>
                <version>${revision}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- İnce WAR paketleme politikası (SORUMLULUK SINIRI — framework zorlar):
                     - zeus-* (framework) jar'ları WAR'a KONUR (WEB-INF/lib).
                     - Tüm 3. parti jar'lar (Spring, Hibernate, Jackson, ...) WAR'a KONMAZ;
                       runtime'da WildFly 'com.zeus' module'ünden gelir.
                     %regex negatif-lookahead ile "zeus- ile başlamayan tüm jar'lar" dışlanır.
                     WAR üreten uygulamalar bu plugin'i devreye alınca otomatik uygulanır.

                     ÖNEMLİ: WAR'dan 3. parti dışlama bir UYGULAMA değil FRAMEWORK (TİP) kararıdır ve
                     buradan zorlanır. Uygulamalar bu yapılandırmayı override ETMEMELİDİR — standart
                     ve soap tiplerinde fat WAR üretmek yasaktır. TEK istisna framework'ün kendisidir:
                     zeus-bff-parent, BFF tipini FRAMEWORK KARARIYLA fat WAR yapar
                     (zeus.war.packaging-excludes boşaltılır). Paylaşımlı 'com.zeus' module'ünü yalnızca framework üretir
                     (scripts/install-zeus-module.sh); uygulamalar module oluşturamaz / module'e jar
                     ekleyemez — yalnızca kendi ince WAR'larını deploy eder.

                     İSTİSNA (app-specific): Bir app, framework'te olmayan ve YALNIZ kendi kullandığı
                     bir kütüphaneyi kendi WAR'ında taşımak isterse ${zeus.war.keep} property'sini set
                     eder (plugin override etmeden). Regex o öneki dışlama dışı bırakır → jar WAR'da
                     kalır, paylaşımlı module'e GİRMEZ. Varsayılan boşken davranış: yalnız zeus-*. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-war-plugin</artifactId>
                    <configuration>
                        <packagingExcludes>${zeus.war.packaging-excludes}</packagingExcludes>
                    </configuration>
                </plugin>

                <!-- TEST ÇALIŞTIRMA — Mockito'yu javaagent olarak takar.
                     Java 25'te Mockito inline-mock-maker kendini JVM'e SELF-ATTACH ediyor ve
                     şu uyarıyı basıyor: "This will no longer work in future releases of the JDK."
                     JDK self-attach'i kapattığı gün, önlem alınmazsa TÜM uygulamaların testleri
                     birden kırılır. Agent'ı önden takmak bunu bugünden çözer.

                     ${org.mockito:mockito-core:jar} property'sini aşağıdaki maven-dependency-plugin
                     'properties' goal'ü üretir. Mockito her modüle zeus-parent'ın
                     spring-boot-starter-test bağımlılığıyla geldiği için property daima çözülür.

                     @{argLine}: geç bağlama — JaCoCo gibi argLine'ı dolduran eklentilerle
                     çakışmaz (tabanı yukarıdaki boş <argLine> property'sidir). -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
                    </configuration>
                </plugin>

                <!-- Bağımlılık jar yollarını property olarak açar (yukarıdaki javaagent için). -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>zeus-dependency-properties</id>
                            <goals>
                                <goal>properties</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- Lombok annotation processor yolu (sürüm Spring Boot BOM'undan). -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>

                <!-- spring-boot-maven-plugin: repackage (fat WAR/JAR) kapalı; spring-boot:run açık. -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>repackage</id>
                            <configuration>
                                <skip>true</skip>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- TÜM alt modüllerde ve tüketen uygulamalarda KOŞULSUZ çalışan eklentiler.
             (pluginManagement yalnızca YAPILANDIRIR; burada listelenmeyen bir eklentinin
             varsayılan yaşam döngüsünde bağlanması yoksa hiç çalışmaz.) -->
        <plugins>
            <!-- dependency:properties — surefire'ın Mockito javaagent'ı için gereken
                 ${org.mockito:mockito-core:jar} property'sini üretir. Yapılandırması
                 yukarıdaki pluginManagement'tan gelir. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- ÜRETİLEN DESCRIPTOR (framework yazar, developer yazmaz):
             WAR uygulamalarının WEB-INF/jboss-deployment-structure.xml'i app repo'sunda TUTULMAZ;
             build sırasında zeus-war-defaults şablonundan üretilir:
               1) dependency:unpack → şablon target/zeus-war-defaults/ altına açılır
               2) maven-war-plugin webResources (filtering=true) → ${zeus.module.slot} doldurulur,
                  dosya WAR'ın WEB-INF'ine konur (webResources, src/main/webapp kopyasından ÖNCE
                  işlendiği için app'te unutulmuş eski bir kopya varsa da üretilen dosya kazanır).

             Aktivasyon: src/main/webapp dizini olan projeler (= WAR uygulamaları). packaging=war
             aktivasyonu Maven 4 özelliği olduğundan (3.9 POM modeli tanımıyor) file-exists kullanılır.
             DİKKAT: WAR uygulamalarında src/main/webapp dizini VAR OLMALI (boşsa .gitkeep ile) —
             yoksa profil devreye girmez ve descriptor üretilmez (verify-module-coverage.sh bu
             durumu deploy'dan önce yakalar). Framework'ün jar/pom modüllerinde webapp dizini
             olmadığından profil onlarda hiç devreye girmez (zeus-war-defaults kendisi dahil —
             döngüsel bağımlılık oluşmaz). -->
        <profile>
            <id>zeus-generated-descriptor</id>
            <activation>
                <file>
                    <exists>${basedir}/src/main/webapp</exists>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>unpack-zeus-war-defaults</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>unpack</goal>
                                </goals>
                                <configuration>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>com.zeus</groupId>
                                            <artifactId>zeus-war-defaults</artifactId>
                                            <version>${revision}</version>
                                        </artifactItem>
                                    </artifactItems>
                                    <includes>${zeus.descriptor.dir}/**</includes>
                                    <outputDirectory>${project.build.directory}/zeus-war-defaults</outputDirectory>
                                    <overWriteSnapshots>true</overWriteSnapshots>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-war-plugin</artifactId>
                        <configuration>
                            <webResources>
                                <resource>
                                    <directory>${project.build.directory}/zeus-war-defaults/${zeus.descriptor.dir}</directory>
                                    <targetPath>WEB-INF</targetPath>
                                    <filtering>true</filtering>
                                </resource>
                            </webResources>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
