<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zeus</groupId>
        <artifactId>zeus-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../zeus-parent</relativePath>
    </parent>

    <artifactId>zeus-wildfly-module</artifactId>
    <packaging>pom</packaging>

    <name>Zeus WildFly Module (paylaşımlı 3. parti bağımlılık sözleşmesi)</name>
    <description>
        WildFly 'com.zeus' module'üne konacak 3. parti kütüphanelerin (Spring, Spring Boot,
        Hibernate, Jackson, ...) TEK ve MERKEZİ bağımlılık sözleşmesi. scripts/install-zeus-module.sh
        bu modülün runtime bağımlılık kapanışını (dependency:copy-dependencies) çözüp module'ü üretir.

        ÖNEMLİ: Bu modül, kendisini paylaşan TÜM uygulamaların runtime 3. parti bağımlılıklarının
        BİRLEŞİMİNİ (union) içermelidir. Yeni bir uygulama, burada olmayan bir kütüphaneye runtime'da
        ihtiyaç duyuyorsa o bağımlılık BURAYA eklenmeli, sonra module yeniden üretilmelidir
        (aksi halde o uygulama WildFly'da NoClassDefFoundError alır).

        Sözleşme İKİ kaynaktan beslenir:
        (1) zeus-* modülleri bağımlılık olarak alınır → 3. parti kapanışları OTOMATİK gelir
            (zeus jar'larının kendisi EXCLUDE_REGEX ile atılır; onlar WAR'da taşınır),
        (2) hiçbir zeus modülünün getirmediği yığın (ör. springdoc) elle sayılır.

        Sürümler zeus BOM'dan gelir; burada YAZILMAZ. CVE yaması = zeus-dependencies BOM'da override.
        Detay: zeus-fw/gelistirmeler/08-wildfly-module-dagitim.md
    </description>

    <dependencies>
        <!-- ═══════════ 1) ZEUS MODÜLLERİ — 3. parti kapanışlarını OTOMATİK getirsin diye ═══════════
             Buradaki amaç zeus jar'larını module'e koymak DEĞİL: install-zeus-module.sh jar
             kopyalarken EXCLUDE_REGEX ile 'zeus-*' (ve lombok, jakarta.*-api) jar'larını atar —
             zeus jar'ları WAR'da taşınır. Bu bağımlılıkların TEK işlevi, modüllerin 3. parti
             kapanışını (slf4j, spring-web, spring-orm, spring-ai, ...) module'e taşımaktır.

             NEDEN: Önceden burada yalnızca Boot starter'ları elle sayılıyordu. Bir zeus modülüne
             yeni bir 3. parti kütüphane eklendiğinde onu BURAYA da elle aynalamak gerekiyordu;
             unutulursa uygulama WildFly'da NoClassDefFoundError alıyordu. Artık kapanış
             modülün kendi pom'undan türüyor — elle senkron tutma ihtiyacı ortadan kalktı. -->
        <dependency>
            <groupId>com.zeus</groupId>
            <artifactId>zeus-base</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zeus</groupId>
            <artifactId>zeus-logger</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zeus</groupId>
            <artifactId>zeus-database</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zeus</groupId>
            <artifactId>zeus-service</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zeus</groupId>
            <artifactId>zeus-ai</artifactId>
        </dependency>

        <!-- BİLEREK YOK: zeus-redis (+50 artefakt: lettuce/jedis) ve zeus-batch (+33 artefakt:
             spring-batch-core/infrastructure). İkisi de iskelet ve HİÇBİR uygulama kullanmıyor;
             paylaşımlı module'e girmeleri, onları kullanmayan tüm uygulamalara restart lockstep
             maliyeti bindirir. Bir uygulama zeus-redis/zeus-batch kullanmaya başladığında
             verify-module-coverage.sh deploy'dan önce kırar; çözüm buraya tek satır eklemektir.

             zeus-soap BURAYA GİRMEZ: CXF yığını ayrı com.zeus.soap module'üne aittir
             (zeus-soap-wildfly-module). zeus-bff-* de girmez: BFF fat WAR'dır, izoledir. -->

        <!-- ═══════════ 2) Uygulamaların doğrudan kullandığı, zeus modüllerinde OLMAYAN yığın ═══════════
             zeus-* modülleri BURAYA KONMAZ (WAR içinde taşınır; install script zaten dışlar).
             Aşağıdaki starter'lar spring-wildfly-arch'ın runtime 3. parti bağımlılıklarını yansıtır. -->
        <!-- Boot 4 modülerleşmesi: starter-web'in yerini starter-webmvc aldı
             (embedded sunucu artık starter'a dahil değil — WildFly/Undertow konteyner). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- Spring AI (zeus-ai modülünün 3. parti kapanışı): spring-ai-client-chat, spring-ai-model,
             spring-ai-openai, openai-java SDK, autoconfigure'lar ve reactor/ST bağımlılıkları.
             zeus-ai'nin KENDİ jar'ı buraya GİRMEZ — o zeus-* olduğu için WAR içinde taşınır. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- Gömülü Tomcat module'e KONMAZ: WildFly servlet konteyneri (Undertow) kullanılır.
             Boot 4'te de starter-webmvc varsayılan olarak starter-tomcat çeker; provided scope
             ile tüm alt ağacı (starter-tomcat-runtime, spring-boot-tomcat, tomcat-embed-core/
             websocket) runtime kapanışından düşer. NOT: tomcat-embed-el KALIR (starter-validation
             üzerinden gelir; hibernate-validator'ın EL implementasyonu — module'de gerekli). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

</project>