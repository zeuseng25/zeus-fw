<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zeus</groupId>
        <artifactId>zeus-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../zeus-parent/pom.xml</relativePath>
    </parent>

    <artifactId>zeus-database</artifactId>
    <packaging>jar</packaging>

    <name>Zeus Database</name>
    <description>Veri erişim modülü: JNDI/direct datasource yapılandırması,
        stored-procedure helper'ları (SimpleJdbcCall / StoredProcedureQuery).</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- Boot 4 modülerleşmesi: DataSourceAutoConfiguration ve HibernateJpaAutoConfiguration
             artık spring-boot-autoconfigure'da değil; teknolojiye özel modüllerde yaşar
             (before/after sıralama referansları için derleme bağımlılığı gerekir). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-hibernate</artifactId>
        </dependency>
        <!-- Hedeflenen içerik: SimpleJdbcCall (spring-jdbc) + StoredProcedureQuery (spring-orm). -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-orm</artifactId>
        </dependency>
        <!-- JPA tabanlı stored-procedure helper'ı için (EntityManager, StoredProcedureQuery).
             Runtime'da JPA sağlayıcısı (Hibernate) kapsayıcıdan/com.zeus module'ünden gelir. -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.zeus</groupId>
            <artifactId>zeus-base</artifactId>
        </dependency>

        <!-- Oracle JDBC sürücüsü. zeus-database Oracle'a KOD olarak bağlı değildir
             (tek bir 'import oracle.*' yoktur; DataSource/SimpleJdbcCall/EntityManager
             kullanılır) — sürücü buraya PAKETLEME kolaylığı için konur:

             Platform Oracle-only olduğundan her uygulamanın aynı sürücü bloğunu tekrar
             yazması gereksiz tekrardı. compile scope GEÇİŞLİDİR: zeus-database ekleyen
             uygulama sürücüyü otomatik alır ve 'local' profilde (embedded Tomcat,
             doğrudan JDBC) hiçbir ek bildirim olmadan çalışır. Sürüm zeus BOM'undan.

             Sürücünün çalışma zamanı yolculuğu:
               - WAR'a girmez        → zeus-parent'ın packagingExcludes'u zeus-* dışını atar
               - com.zeus'a girmez   → install-zeus-module.sh EXCLUDE_REGEX'i ojdbc'yi dışlar
               - WildFly'da          → sunucunun kendi com.oracle.ojdbc module'ünden gelir
             Böylece sunucuda TEK sürücü olur (çift kopya ClassCastException üretirdi). -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc17</artifactId>
        </dependency>
    </dependencies>

</project>
