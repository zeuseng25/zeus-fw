<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot tabanı: Spring/Hibernate/Jackson/logging vb. sürümleri ve
         plugin yönetimi (compiler, war, spring-boot) buradan miras alınır. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>com.zeus</groupId>
    <artifactId>zeus-fw</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>Zeus Framework (kök)</name>
    <description>Zeus Framework aggregator: BOM + parent + modüller (Spring Boot tarzı)</description>

    <properties>
        <!-- TEK VERSİYON KAYNAĞI: tüm zeus modülleri bu değeri kullanır.
             Değiştirmek için yalnızca burayı güncellemek yeterlidir. -->
        <!-- 2.0.0: Spring Boot 4 / Java 25 / WildFly 41 platformu — KIRICI sürüm
             (starter adları değişti; bkz. gelistirmeler/13-java25-boot4-wildfly41-yukseltme.md). -->
        <revision>2.0.0-SNAPSHOT</revision>

        <java.version>25</java.version>
        <!-- Spring Framework sürümü PIN'LENMEZ: Boot 4 BOM'u Framework 7.0.x'i yönetir.
             (CVE gerekirse override yeri zeus-dependencies BOM'udur, burası değil.) -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <flatten-maven-plugin.version>1.6.0</flatten-maven-plugin.version>
    </properties>

    <!-- Reaktör sırası: önce BOM ve parent, sonra modüller. -->
    <modules>
        <module>zeus-dependencies</module>
        <module>zeus-parent</module>
        <!-- Uygulama TİPİNE özel parent'lar (zeus-parent'tan türerler; tek ${revision}). -->
        <module>zeus-soap-parent</module>
        <module>zeus-bff-parent</module>
        <module>zeus-base</module>
        <module>zeus-logger</module>
        <module>zeus-database</module>
        <module>zeus-service</module>
        <module>zeus-redis</module>
        <module>zeus-batch</module>
        <!-- LLM erişimi (Spring AI 2.x, OpenAI-uyumlu endpoint: vLLM / LiteLLM / OpenRouter). -->
        <module>zeus-ai</module>
        <!-- Tip modülleri: SOAP (CXF altyapısı) ve BFF (gateway + login iskeleti). -->
        <module>zeus-soap</module>
        <module>zeus-bff-starter</module>
        <module>zeus-bff-login</module>
        <!-- WAR uygulamalarına build'de enjekte edilen varsayılan deployment dosyası şablonları. -->
        <module>zeus-war-defaults</module>
        <!-- Paylaşımlı WildFly module bağımlılık sözleşmeleri (jar üretmezler):
             com.zeus (temel Spring yığını) + com.zeus.soap (CXF yığını). -->
        <module>zeus-wildfly-module</module>
        <module>zeus-soap-wildfly-module</module>
    </modules>

    <build>
        <!-- flatten-maven-plugin: yayınlanan (install/deploy) pom'larda ${revision}
             yerine somut sürümü yazar. resolveCiFriendliesOnly modu pom'un geri kalanını
             (dependencyManagement/pluginManagement) AYNEN korur. Kökte tanımlı olduğu için
             tüm alt modüller (pom ve jar) miras alır. -->
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
