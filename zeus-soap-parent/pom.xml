<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zeus</groupId>
        <artifactId>zeus-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../zeus-parent/pom.xml</relativePath>
    </parent>

    <artifactId>zeus-soap-parent</artifactId>
    <packaging>pom</packaging>

    <name>Zeus SOAP Parent</name>
    <description>SOAP (Apache CXF / JAX-WS) uygulamalarının parent'ı. zeus-parent'tan türer:
        BOM, lombok, ince WAR politikası ve üretilen descriptor mekanizması miras alınır.
        Farklar: SOAP tipi descriptor (webservices subsystem dışlaması + com.zeus.soap
        module bağımlılığı). CXF jar'ları WAR'a GİRMEZ; paylaşımlı com.zeus.soap WildFly
        module'ünden gelir (üretimi: scripts/install-zeus-module.sh - -module soap).
        Sürüm politikası: hangi parent kullanılırsa kullanılsın tek ${revision}.</description>

    <properties>
        <!-- SOAP tipi descriptor şablonu (webservices dışlaması + com.zeus.soap dep). -->
        <zeus.descriptor.dir>descriptor-soap</zeus.descriptor.dir>

        <!-- com.zeus.soap module SLOT'u — com.zeus slot politikasıyla aynı kurallar
             (platform release başına sabitlenir; bkz. 10-versiyonlu-slot dokümanı). -->
        <zeus.soap.module.slot>main</zeus.soap.module.slot>

        <!-- SOAP TİPİ WAR dışlaması — BİRLEŞİM: com.zeus ∪ com.zeus.soap.
             zeus-parent'ınkini MİRAS ALMAK YETMEZ: o yalnız com.zeus'u kapsar, CXF yığını
             (com.zeus.soap) WAR'a girer ve module ile ÇİFT KOPYA olur → LinkageError.
             Kural: iki module'den hiçbirinin içeriği WAR'a konmaz.
             Aşağıdaki blok ÜRETİLİR; elle düzenlenmez. -->
        <!-- ZEUS-WAR-EXCLUDES:BEGIN — ÜRETİLMİŞTİR, ELLE DÜZENLEMEYİN (scripts/generate-war-excludes.sh) -->
        <zeus.war.packaging-excludes>%regex[WEB-INF/lib/(HdrHistogram|HikariCP|LatencyUtils|ST4|angus-activation|angus-mail|annotations|antlr-runtime|antlr4-runtime|asm|aspectjweaver|byte-buddy|classmate|commons-lang3|commons-logging|context-propagation|cxf-core|cxf-rt-bindings-soap|cxf-rt-bindings-xml|cxf-rt-databinding-jaxb|cxf-rt-features-metrics|cxf-rt-frontend-jaxws|cxf-rt-frontend-simple|cxf-rt-transports-http|cxf-rt-ws-addr|cxf-rt-ws-policy|cxf-rt-wsdl|cxf-spring-boot-autoconfigure|cxf-spring-boot-starter-jaxws|error_prone_annotations|hibernate-core|hibernate-models|hibernate-validator|istack-commons-runtime|itu|jackson-annotations|jackson-core|jackson-databind|jackson-dataformat-yaml|jackson-datatype-jdk8|jackson-datatype-jsr310|jackson-module-kotlin|jakarta\.activation-api|jakarta\.annotation-api|jakarta\.inject-api|jakarta\.mail-api|jakarta\.persistence-api|jakarta\.transaction-api|jakarta\.validation-api|jakarta\.xml\.bind-api|jakarta\.xml\.soap-api|jakarta\.xml\.ws-api|jaxb-core|jaxb-runtime|jboss-logging|json-schema-validator|jsonschema-generator|jsonschema-module-jackson|jsonschema-module-swagger-2|jspecify|jtokkit|jul-to-slf4j|kotlin-reflect|kotlin-stdlib|kotlin-stdlib-common|kotlin-stdlib-jdk7|kotlin-stdlib-jdk8|log4j-api|log4j-to-slf4j|logback-classic|logback-core|micrometer-commons|micrometer-core|micrometer-observation|neethi|netty-buffer|netty-codec-base|netty-codec-classes-quic|netty-codec-compression|netty-codec-dns|netty-codec-http|netty-codec-http2|netty-codec-http3|netty-codec-native-quic|netty-codec-socks|netty-common|netty-handler|netty-handler-proxy|netty-resolver|netty-resolver-dns|netty-resolver-dns-classes-macos|netty-resolver-dns-native-macos|netty-transport|netty-transport-classes-epoll|netty-transport-native-epoll|netty-transport-native-unix-common|ojdbc17|okhttp|okio|okio-jvm|openai-java-core|reactive-streams|reactor-core|reactor-netty-core|reactor-netty-http|slf4j-api|snakeyaml|spring-ai-autoconfigure-model-chat-client|spring-ai-autoconfigure-model-chat-memory|spring-ai-autoconfigure-model-chat-observation|spring-ai-autoconfigure-model-embedding-observation|spring-ai-autoconfigure-model-image-observation|spring-ai-autoconfigure-model-openai|spring-ai-autoconfigure-model-tool|spring-ai-autoconfigure-retry|spring-ai-client-chat|spring-ai-commons|spring-ai-model|spring-ai-openai|spring-ai-starter-model-openai|spring-ai-template-st|spring-aop|spring-aspects|spring-beans|spring-boot|spring-boot-autoconfigure|spring-boot-data-commons|spring-boot-data-jpa|spring-boot-hibernate|spring-boot-http-client|spring-boot-http-codec|spring-boot-http-converter|spring-boot-jackson|spring-boot-jdbc|spring-boot-jpa|spring-boot-persistence|spring-boot-reactor|spring-boot-restclient|spring-boot-servlet|spring-boot-sql|spring-boot-starter|spring-boot-starter-data-jpa|spring-boot-starter-jackson|spring-boot-starter-jdbc|spring-boot-starter-logging|spring-boot-starter-restclient|spring-boot-starter-validation|spring-boot-starter-web|spring-boot-starter-webclient|spring-boot-starter-webmvc|spring-boot-transaction|spring-boot-validation|spring-boot-web-server|spring-boot-webclient|spring-boot-webmvc|spring-context|spring-context-support|spring-core|spring-data-commons|spring-data-jpa|spring-expression|spring-jdbc|spring-messaging|spring-orm|spring-tx|spring-web|spring-webflux|spring-webmvc|springdoc-openapi-starter-common|springdoc-openapi-starter-webmvc-api|springdoc-openapi-starter-webmvc-ui|stax2-api|swagger-annotations|swagger-annotations-jakarta|swagger-core-jakarta|swagger-models-jakarta|swagger-ui|tomcat-embed-el|txw2|webjars-locator-lite|woodstox-core|wsdl4j|xml-resolver|xmlschema-core|ojdbc[0-9]+|orai18n|ucp[0-9]+|jakarta\.[a-z.]+-api|lombok|spring-boot-jarmode-[a-z]+)-[0-9][^/]*\.jar]</zeus.war.packaging-excludes>
        <!-- ZEUS-WAR-EXCLUDES:END -->
    </properties>

</project>
