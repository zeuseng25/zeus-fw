<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zeus</groupId>
        <artifactId>zeus-fw</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>zeus-dependencies</artifactId>
    <packaging>pom</packaging>

    <name>Zeus Framework BOM</name>
    <description>Tüm zeus modüllerinin ve 3. parti kütüphanelerin sürümlerini yöneten BOM
        (spring-boot-dependencies benzeri). Dışarıdan scope=import ile alınır.</description>

    <properties>
        <!-- 3. parti sürümler: Spring Boot BOM'unun yönetmediği kütüphaneler burada sabitlenir. -->
        <!-- springdoc 3.x = Spring Boot 4 / Framework 7 uyumlu satır (2.x Boot 4 ile ÇALIŞMAZ). -->
        <springdoc-openapi.version>3.0.3</springdoc-openapi.version>
        <!-- ojdbc17 = JDK 17+ (Java 25 dahil) için Oracle 23ai sürücü satırı. -->
        <ojdbc.version>23.9.0.25.07</ojdbc.version>
        <!-- CXF 4.2.x = Jakarta EE 11 / Spring Framework 7 / Boot 4 uyumlu satır (SOAP tipi). -->
        <cxf.version>4.2.2</cxf.version>
        <!-- Oakwood (2025.1.x) = Spring Boot 4 uyumlu Spring Cloud release train (BFF tipi). -->
        <spring-cloud.version>2025.1.2</spring-cloud.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot yönetimi: bu BOM tek başına import edildiğinde de
                 Spring/Hibernate/Jackson/redis/batch sürümleri çözülebilsin diye. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>4.0.7</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud BOM'u Boot BOM'undan SONRA import edilir (Maven kuralı: örtüşen
                 yönetimlerde İLK import kazanır → Boot sürümleri geçerli kalır — bilinçli tercih). -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Zeus modülleri — hepsi tek ${revision} sürümüyle. -->
            <dependency>
                <groupId>com.zeus</groupId>
                <artifactId>zeus-base</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.zeus</groupId>
                <artifactId>zeus-logger</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.zeus</groupId>
                <artifactId>zeus-database</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.zeus</groupId>
                <artifactId>zeus-service</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.zeus</groupId>
                <artifactId>zeus-redis</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.zeus</groupId>
                <artifactId>zeus-batch</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.zeus</groupId>
                <artifactId>zeus-soap</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.zeus</groupId>
                <artifactId>zeus-bff-starter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.zeus</groupId>
                <artifactId>zeus-bff-login</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- Ekstra 3. parti kütüphaneler (Spring Boot BOM dışı). -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc-openapi.version}</version>
            </dependency>
            <dependency>
                <groupId>com.oracle.database.jdbc</groupId>
                <artifactId>ojdbc17</artifactId>
                <version>${ojdbc.version}</version>
            </dependency>
            <!-- SOAP tipi: Apache CXF (JAX-WS). Uygulamalar ve zeus-soap sürüm yazmadan kullanır. -->
            <dependency>
                <groupId>org.apache.cxf</groupId>
                <artifactId>cxf-spring-boot-starter-jaxws</artifactId>
                <version>${cxf.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
