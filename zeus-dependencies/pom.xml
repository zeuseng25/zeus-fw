<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zeus</groupId>
        <artifactId>zeus-fw</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>zeus-dependencies</artifactId>
    <packaging>pom</packaging>

    <name>Zeus Framework BOM</name>
    <description>Tüm zeus modüllerinin ve 3. parti kütüphanelerin sürümlerini yöneten BOM
        (spring-boot-dependencies benzeri). Dışarıdan scope=import ile alınır.</description>

    <properties>
        <!-- 3. parti sürümler: Spring Boot BOM'unun yönetmediği kütüphaneler burada sabitlenir. -->
        <springdoc-openapi.version>2.2.0</springdoc-openapi.version>
        <ojdbc.version>23.4.0.24.05</ojdbc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot yönetimi: bu BOM tek başına import edildiğinde de
                 Spring/Hibernate/Jackson/redis/batch sürümleri çözülebilsin diye. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>3.1.3</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Zeus modülleri — hepsi tek ${revision} sürümüyle. -->
            <dependency>
                <groupId>com.zeus</groupId>
                <artifactId>zeus-base</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.zeus</groupId>
                <artifactId>zeus-logger</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.zeus</groupId>
                <artifactId>zeus-database</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.zeus</groupId>
                <artifactId>zeus-service</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.zeus</groupId>
                <artifactId>zeus-redis</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.zeus</groupId>
                <artifactId>zeus-batch</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- Ekstra 3. parti kütüphaneler (Spring Boot BOM dışı). -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc-openapi.version}</version>
            </dependency>
            <dependency>
                <groupId>com.oracle.database.jdbc</groupId>
                <artifactId>ojdbc11</artifactId>
                <version>${ojdbc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
